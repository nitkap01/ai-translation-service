# Copy to .env and adjust as needed. All values are optional.

# torch device for translation + TTS: auto | mps | cpu
DEVICE=auto

# Model ids
WHISPER_MODEL=large-v3
NLLB_MODEL=facebook/nllb-200-distilled-600M
MMS_TTS_PREFIX=facebook/mms-tts-

# Reject uploads larger than this many megabytes
MAX_AUDIO_MB=25

# Where Hugging Face caches downloaded models. Point at a drive with room
# if your main disk is tight, e.g. /Volumes/External/hf-cache
# HF_HOME=/Volumes/External/hf-cache

# Let unsupported MPS ops fall back to CPU instead of erroring (Apple Silicon)
PYTORCH_ENABLE_MPS_FALLBACK=1
